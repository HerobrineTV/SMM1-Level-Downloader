<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SMMDownloader.Avalonia.Controls"
        xmlns:models="clr-namespace:SMMDownloader.Avalonia.Models"
        x:Class="SMMDownloader.Avalonia.MainWindow"
        Title="Super Mario Maker 1 Level Downloader"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Icon="/Assets/Icon.ico">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="#F9C74F" />
      <Setter Property="Foreground" Value="#2B1605" />
      <Setter Property="BorderBrush" Value="#8F4F17" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Foreground" Value="#2B1605" />
      <Setter Property="Background" Value="#FFD96A" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Foreground" Value="#2B1605" />
      <Setter Property="Background" Value="#EFB934" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="#6B4A23" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#6B4A23" />
    </Style>
    <Style Selector="Button.socialButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="#FFF8D6" />
      <Setter Property="Foreground" Value="#251505" />
      <Setter Property="BorderBrush" Value="#A86725" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#FFF8D6" />
      <Setter Property="Foreground" Value="#251505" />
      <Setter Property="BorderBrush" Value="#A86725" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="ComboBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#251505" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:pointerover">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:pressed">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:checked">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="CheckBox:checked /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#FFF4BD" />
      <Setter Property="Foreground" Value="#241301" />
      <Setter Property="BorderBrush" Value="#9B5A1E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="ListBoxItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="#FFF4BD" />
      <Setter Property="Foreground" Value="#241301" />
      <Setter Property="BorderBrush" Value="#9B5A1E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TreeViewItem:pointerover">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TreeViewItem:selected">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TreeViewItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock">
      <Setter Property="Foreground" Value="#241301" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#2B1605" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="TabItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="TabItem:selected TextBlock">
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="#7B4A20" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="#FFF1AE" />
      <Setter Property="BoxShadow" Value="0 4 0 0 #6E3F17" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#2B1605" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B4A23" />
    </Style>
    <Style Selector="Border.statChip">
      <Setter Property="Background" Value="#FFF8D6" />
      <Setter Property="BorderBrush" Value="#A86725" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
  </Window.Styles>

  <Grid>
    <controls:FloatingSpriteBackgroundControl />
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Margin="16,14,16,10"
              Padding="14,10"
              CornerRadius="6"
              Background="#E94B35"
              BorderBrush="#7B2018"
              BorderThickness="2"
              BoxShadow="0 4 0 0 #65180F">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="34" Height="34" Background="#F9C74F" BorderBrush="#7B2018" BorderThickness="2" CornerRadius="4">
              <TextBlock Text="?" FontSize="22" FontWeight="Bold" Foreground="#2B1605" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Super Mario Maker 1 Level Downloader"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="#2B1605"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="VersionText"
                         Text="Version"
                         FontSize="11"
                         Foreground="#4F2C0C"
                         FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="24,0,0,0">
            <Button x:Name="UpdateButton"
                    Content="Update available"
                    IsVisible="False"
                    Click="UpdateButton_OnClick" />
            <Button x:Name="NotificationButton"
                    Content="Notifications"
                    Click="NotificationButton_OnClick" />
            <Border Background="#FFF8D6"
                    BorderBrush="#7B2018"
                    BorderThickness="2"
                    CornerRadius="5"
                    Padding="10,5">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border x:Name="ApiStatusDot"
                        Width="10"
                        Height="10"
                        Background="#A86725"
                        CornerRadius="5"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="ApiStatusText"
                           Text="API: Checking"
                           Foreground="#2B1605"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,0,16,16">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="False" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem x:Name="DownloadTab" Header="Download">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <Border Classes="panel" Grid.Row="0">
            <StackPanel Spacing="10">
              <TextBlock x:Name="SearchCoursesTitle" Text="Search Courses" Classes="sectionTitle" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="SearchTextBox"
                         Watermark="Level name, level ID, creator name or creator ID" />
                <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="SearchButton_OnClick" />
                <Button x:Name="RandomButton" Grid.Column="2" Content="Random" Click="RandomButton_OnClick" />
              </Grid>
              <WrapPanel>
                <CheckBox x:Name="SearchLevelNameCheckBox" Content="Level Name" />
                <CheckBox x:Name="SearchLevelIdCheckBox" Content="Level ID" />
                <CheckBox x:Name="SearchCreatorNameCheckBox" Content="Creator Name" />
                <CheckBox x:Name="SearchCreatorIdCheckBox" Content="Creator ID" />
                <CheckBox x:Name="SearchExactCheckBox" Content="Exact" />
              </WrapPanel>
              <WrapPanel>
                <CheckBox x:Name="DownloadToPackCheckBox" Content="Save in Level Pack" />
                <AutoCompleteBox x:Name="PackNameTextBox"
                                 Width="220"
                                 Watermark="Level Pack Name"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="0"
                                 TextChanged="PackNameTextBox_OnTextChanged"
                                 SelectionChanged="PackNameTextBox_OnSelectionChanged" />
                <Button x:Name="DownloadAllButton" Content="Download All Results" Click="DownloadAllButton_OnClick" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Grid x:Name="SearchResultsLayout" Grid.Row="1" ColumnDefinitions="*,0" ColumnSpacing="12" Margin="0,12,0,0">
            <Border x:Name="CemuLevelsPanel" Classes="panel">
              <ListBox x:Name="SearchResultsListBox"
                       SelectionChanged="SearchResultsListBox_OnSelectionChanged"
                       ScrollViewer.ScrollChanged="SearchResultsListBox_OnScrollChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Margin="0,5">
                      <Border Width="72"
                              Height="42"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              Cursor="Hand"
                              PointerPressed="SearchThumbnail_OnPointerPressed"
                              IsVisible="{Binding HasThumbnail}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#241301" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCreatorMiiImage}">
                              <Border Width="28"
                                      Height="28"
                                      Background="#E9D58A"
                                      BorderBrush="#8F4F17"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      ClipToBounds="True"
                                      Cursor="Hand"
                                      PointerPressed="CreatorMii_OnPointerPressed">
                                <Image Source="{Binding CreatorMiiImage}" Stretch="UniformToFill" />
                              </Border>
                              <TextBlock Text="Creator" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWorldRecordMiiImage}">
                              <Border Width="28"
                                      Height="28"
                                      Background="#E9D58A"
                                      BorderBrush="#8F4F17"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      ClipToBounds="True"
                                      Cursor="Hand"
                                      PointerPressed="WorldRecordMii_OnPointerPressed">
                                <Image Source="{Binding WorldRecordMiiImage}" Stretch="UniformToFill" />
                              </Border>
                              <TextBlock Text="WR" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Border Classes="statChip">
                                <TextBlock FontSize="12" Foreground="#2B1605">
                                  <Run Text="#" />
                                  <Run Text="{Binding DisplayCode}" />
                                </TextBlock>
                              </Border>
                              <Border Classes="statChip">
                                <TextBlock FontSize="12" Foreground="#2B1605">
                                  <Run Text="✓ " />
                                  <Run Text="{Binding ClearRateText}" />
                                </TextBlock>
                              </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Border Classes="statChip">
                                <TextBlock FontSize="12" Foreground="#2B1605">
                                  <Run Text="▶ " />
                                  <Run Text="{Binding TotalAttemptsText}" />
                                </TextBlock>
                              </Border>
                              <Border Classes="statChip">
                                <TextBlock FontSize="12" Foreground="#2B1605">
                                  <Run Text="★ " />
                                  <Run Text="{Binding StarsText}" />
                                </TextBlock>
                              </Border>
                              <Border Classes="statChip">
                                <TextBlock FontSize="12" Foreground="#2B1605">
                                  <Run Text="DL " />
                                  <Run Text="{Binding DownloadsText}" />
                                </TextBlock>
                              </Border>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SearchResultStatus}" FontSize="12" Foreground="#1A7A3A" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Content="{Binding DownloadButtonText}"
                              IsEnabled="{Binding CanDownload}"
                              Click="DownloadLevelButton_OnClick" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Border x:Name="SearchSelectedLevelContainer" Classes="panel" Grid.Column="1" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="SelectedCourseTitle" Text="Selected Course" Classes="sectionTitle" />
                  <TextBlock x:Name="SelectedLevelTitle" Text="No course selected" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                  <StackPanel x:Name="SelectedCourseDetailsPanel" Spacing="8" IsVisible="False">
                  <Grid x:Name="SelectedCreatorRow" ColumnDefinitions="64,*" ColumnSpacing="10" IsVisible="False">
                    <StackPanel x:Name="SelectedCreatorMiiPanel" Spacing="3" IsVisible="False">
                      <Border Width="46"
                              Height="46"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              Cursor="Hand"
                              PointerPressed="SelectedCreatorMii_OnPointerPressed">
                        <Image x:Name="SelectedCreatorMiiImage" Stretch="UniformToFill" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="SelectedCreatorHeader" Text="Creator" FontSize="11" Classes="muted" />
                      <TextBlock x:Name="SelectedCreatorNameText" Text="-" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="SelectedWorldRecordRow" ColumnDefinitions="64,*" ColumnSpacing="10" IsVisible="False">
                    <StackPanel x:Name="SelectedWorldRecordMiiPanel" Spacing="3" IsVisible="False">
                      <Border Width="46"
                              Height="46"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              Cursor="Hand"
                              PointerPressed="SelectedWorldRecordMii_OnPointerPressed">
                        <Image x:Name="SelectedWorldRecordMiiImage" Stretch="UniformToFill" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="SelectedWorldRecordHeader" Text="World Record" FontSize="11" Classes="muted" />
                      <TextBlock x:Name="SelectedWorldRecordText" Text="-" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="SelectedUploadText" TextWrapping="Wrap" Foreground="#2B1605" />
                  <WrapPanel>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SelectedStarsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SelectedDownloadsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SelectedTotalRunsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SelectedClearsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SelectedClearRateText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                  </WrapPanel>
                  <Border x:Name="SearchSelectedPreviewPanel"
                          Height="160"
                          BorderBrush="#A86725"
                          BorderThickness="1.5"
                          CornerRadius="5"
                          Padding="6"
                          Background="#FFF8D6"
                          Cursor="Hand"
                          PointerPressed="SearchSelectedPreviewPanel_OnPointerPressed"
                          IsVisible="False">
                    <Viewbox Stretch="Uniform">
                      <controls:CoursePreviewControl x:Name="SearchSelectedPreviewCanvas" />
                    </Viewbox>
                  </Border>
                  </StackPanel>
                  <StackPanel x:Name="SelectedDownloadStatusPanel" Spacing="8" IsVisible="False">
                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="8" />
                    <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" Foreground="#2B1605" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="SavedCoursesTab" Header="Saved Courses">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <ComboBox x:Name="SavedSourceComboBox" Width="250" Height="36" SelectionChanged="SavedSourceComboBox_OnSelectionChanged">
              <ComboBoxItem Content="Saved Courses" Tag="downloaded" IsSelected="True" />
              <ComboBoxItem Content="Official Testing Courses" Tag="official" />
              <ComboBoxItem Content="Cemu Profile Courses" Tag="cemu" />
              <ComboBoxItem Content="Backupped Courses" Tag="backupped" />
            </ComboBox>
            <TextBox x:Name="SavedSearchTextBox" Width="260" Height="36" Margin="0,0,8,0" Watermark="Filter saved courses" TextChanged="SavedSearchTextBox_OnTextChanged" />
            <Button x:Name="RefreshSavedButton" Content="Refresh" Click="RefreshSavedButton_OnClick" />
            <Button x:Name="OpenSavedFolderButton" Content="Open Folder" Click="OpenSavedFolderButton_OnClick" />
            <Button x:Name="DeleteSavedButton" Content="Delete Selected" Click="DeleteSavedButton_OnClick" />
            <Button x:Name="RemoveSelectedPackButton" Content="Remove Course Pack Folder" IsVisible="False" Click="RemoveSelectedPackButton_OnClick" />
            <Button x:Name="ResetOfficialButton" Content="Reset Official Courses" Click="ResetOfficialButton_OnClick" />
          </WrapPanel>
          <Grid x:Name="SavedLevelsLayout" Grid.Row="1" ColumnDefinitions="*,0" ColumnSpacing="12">
            <Border Classes="panel">
              <TreeView x:Name="SavedLevelsTreeView" SelectionChanged="SavedLevelsTreeView_OnSelectionChanged">
                <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="models:SavedLevelNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="{Binding RowMargin}" PointerPressed="SavedLevelNode_OnPointerPressed">
                      <Border Width="72"
                              Height="42"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              IsVisible="{Binding HasThumbnail}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <Border Width="42"
                              Height="32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="#F9C74F"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              IsVisible="{Binding IsFolder}">
                        <Path Width="25"
                              Height="18"
                              Stretch="Uniform"
                              Fill="#D99022"
                              Stroke="#8F4F17"
                              StrokeThickness="1.4"
                              Data="M2 6 L8 6 L10 8 L22 8 L22 19 L2 19 Z" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#241301" />
                        <TextBlock Text="{Binding ShortInfo}" FontSize="12" Classes="muted" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ShowStats}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="#" />
                              <Run Text="{Binding CodeText}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="✓ " />
                              <Run Text="{Binding ClearRateText}" />
                            </TextBlock>
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="▶ " />
                              <Run Text="{Binding AttemptsText}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="★ " />
                              <Run Text="{Binding StarsText}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="DL " />
                              <Run Text="{Binding DownloadsText}" />
                            </TextBlock>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2"
                              Width="26"
                              Height="26"
                              Padding="0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              IsVisible="{Binding CanDeleteFolder}"
                              ToolTip.Tip="Delete Pack"
                              Click="DeletePackButton_OnClick">
                        <Path Width="13"
                              Height="15"
                              Stretch="Uniform"
                              Data="M6 2 L14 2 M8 2 L8 4 M12 2 L12 4 M4 5 L16 5 M6 5 L7 17 L13 17 L14 5 M9 8 L9 14 M11 8 L11 14"
                              Stroke="#2B1605"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round" />
                      </Button>
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.DataTemplates>
              </TreeView>
            </Border>
            <Border x:Name="SavedSelectedLevelContainer" Classes="panel" Grid.Column="1" IsVisible="False">
              <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Spacing="4">
                  <Button x:Name="OpenSelectedLevelFolderButton"
                          Width="30"
                          Height="30"
                          Padding="0"
                          ToolTip.Tip="Open Level Folder"
                          Click="OpenSelectedLevelFolderButton_OnClick">
                    <Path Width="16"
                          Height="14"
                          Stretch="Uniform"
                          Data="M3 6 L8 6 L10 8 L21 8 L21 19 L3 19 Z M3 6 L3 4 L9 4 L11 6"
                          Fill="#D99022"
                          Stroke="#2B1605"
                          StrokeThickness="1.8" />
                  </Button>
                  <Button x:Name="RefreshSavedMetadataButton"
                          Width="30"
                          Height="30"
                          Padding="0"
                          IsVisible="False"
                          ToolTip.Tip="Refresh Data"
                          Click="RefreshSavedMetadataButton_OnClick">
                    <Path Width="15"
                          Height="15"
                          Stretch="Uniform"
                          Data="M21 2 L21 8 L15 8 M3 12 A9 9 0 0 1 18 5.3 L21 8 M3 22 L3 16 L9 16 M21 12 A9 9 0 0 1 6 18.7 L3 16"
                          Stroke="#2B1605"
                          StrokeThickness="2"
                          StrokeLineCap="Round" />
                  </Button>
                </StackPanel>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,0">
                  <TextBlock x:Name="SavedLevelTitle"
                             Grid.Row="0"
                             Margin="0,0,38,8"
                             Text="Select a saved course"
                             FontSize="17"
                             FontWeight="Bold"
                             Foreground="#2B1605"
                             TextWrapping="Wrap" />
                  <Grid x:Name="SavedLevelDetailsPanel" Grid.Row="1" Grid.RowSpan="4" RowDefinitions="Auto,Auto,Auto,*" IsVisible="False">
                  <Grid Grid.Row="0" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                    <TextBlock x:Name="SavedCreatorHeader" Text="Creator" FontSize="11" Classes="muted" />
                    <TextBlock x:Name="SavedClearRateHeader" Text="Clear Rate" Grid.Column="1" FontSize="11" Classes="muted" />
                    <TextBlock x:Name="SavedWorldRecordHeader" Text="World Record" Grid.Column="2" FontSize="11" Classes="muted" />
                    <DockPanel Grid.Row="1" LastChildFill="True">
                      <Border x:Name="CreatorMiiBorder"
                              Width="32"
                              Height="32"
                              Margin="0,0,7,0"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              Cursor="Hand"
                              PointerPressed="SavedCreatorMii_OnPointerPressed"
                              IsVisible="False">
                        <Image x:Name="CreatorMiiImage" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock x:Name="SavedLevelCreatorText" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SavedLevelClearRateText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" />
                    <DockPanel Grid.Row="1" Grid.Column="2" LastChildFill="True">
                      <Border x:Name="WorldRecordMiiBorder"
                              Width="32"
                              Height="32"
                              Margin="0,0,7,0"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              Cursor="Hand"
                              PointerPressed="SavedWorldRecordMii_OnPointerPressed"
                              IsVisible="False">
                        <Image x:Name="WorldRecordMiiImage" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock x:Name="SavedLevelWorldRecordText" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                  </Grid>
                  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Border Classes="statChip">
                      <TextBlock x:Name="SavedStarsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SavedDownloadsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SavedTotalRunsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statChip">
                      <TextBlock x:Name="SavedClearsText" Foreground="#2B1605" FontWeight="SemiBold" />
                    </Border>
                  </WrapPanel>
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBlock x:Name="CoursePreviewInfo"
                               Text="The course preview will appear below."
                               FontSize="12"
                               Classes="muted"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button x:Name="UnderworldPreviewButton"
                            Grid.Column="1"
                            Content="Underworld"
                            Click="UnderworldPreviewButton_OnClick" />
                    <Button x:Name="HiddenBlocksPreviewButton"
                            Grid.Column="2"
                            Content="Reveal Hidden ? Blocks"
                            Click="HiddenBlocksPreviewButton_OnClick" />
                  </Grid>
                  <ScrollViewer x:Name="CoursePreviewScrollViewer"
                                Grid.Row="3"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <controls:CoursePreviewControl x:Name="CoursePreviewCanvas" />
                  </ScrollViewer>
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="CemuTab" Header="CEMU">
        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="CemuStatusText"
                       Text="CEMU save found"
                       Classes="sectionTitle"
                       Margin="0,4,16,0" />
            <Button x:Name="RefreshCemuButton"
                    Content="Refresh"
                    Click="RefreshCemuButton_OnClick" />
            <Button x:Name="OpenCemuFolderButton"
                    Content="Open Folder"
                    Click="OpenCemuFolderButton_OnClick" />
            <ComboBox x:Name="ProfileComboBox"
                      Width="240"
                      Margin="8,0,0,0"
                      SelectionChanged="ProfileComboBox_OnSelectionChanged" />
          </WrapPanel>
          <Grid Grid.Row="1">
            <Border x:Name="CemuEmptyPanel"
                    Classes="panel"
                    IsVisible="False">
              <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock x:Name="CemuEmptyTitle"
                           Text="CEMU save was not found"
                           Classes="sectionTitle"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CemuEmptyMessage"
                           Text="CEMU is detected automatically."
                           Foreground="#2B1605"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <Border Background="#FFF8D6"
                        BorderBrush="#A86725"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Padding="10">
                  <TextBlock x:Name="CemuEmptyPathText"
                             Text="Detected path: not found"
                             Foreground="#2B1605"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <ScrollViewer x:Name="CemuLevelsScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            SizeChanged="CemuLevelsScrollViewer_OnSizeChanged">
                <ItemsControl x:Name="CemuLevelsItemsControl">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border MinWidth="174"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,12,12"
                              Padding="8"
                              Background="#FFF8D6"
                              BorderBrush="#A86725"
                              BorderThickness="1.5"
                              CornerRadius="5"
                              Cursor="Hand"
                              PointerPressed="CemuLevelCard_OnPointerPressed">
                        <StackPanel Spacing="7">
                          <Border Height="96"
                                  Background="#E9D58A"
                                  BorderBrush="#8F4F17"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  ClipToBounds="True"
                                  IsVisible="{Binding HasThumbnail}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>
                          <Border Height="96"
                                  Background="#E9D58A"
                                  BorderBrush="#8F4F17"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  IsVisible="{Binding NoThumbnail}">
                            <TextBlock Text="No Preview"
                                       Classes="muted"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding DisplayName}"
                                     FontWeight="SemiBold"
                                     Foreground="#241301"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     MaxHeight="42" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="SettingsTab" Header="Settings">
        <Border Classes="panel" Margin="0,12,0,0">
          <StackPanel Spacing="12">
            <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="LanguageLabel" Text="Language" FontWeight="SemiBold" />
            <ComboBox x:Name="LanguageComboBox" Width="220" SelectionChanged="LanguageComboBox_OnSelectionChanged">
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="Deutsch" Tag="de" />
            </ComboBox>
            <CheckBox x:Name="HideViewerInfoCheckBox"
                      Content="Hide Viewer Info"
                      Checked="HideViewerInfoCheckBox_OnChanged"
                      Unchecked="HideViewerInfoCheckBox_OnChanged" />
            <CheckBox x:Name="UseProxyCheckBox" Content="Use Proxy for Downloads" />
            <Button x:Name="OpenProxyFileButton" Content="Open Proxy File" Click="OpenProxyFileButton_OnClick" HorizontalAlignment="Left" />
            <TextBlock x:Name="DebugSettingsTitle" Text="Debug Mode" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Spacing="8" Margin="12,0,0,0">
              <TextBlock x:Name="DebugLevelViewerTitle" Text="Level Viewer" FontWeight="SemiBold" />
              <StackPanel Spacing="8" Margin="12,0,0,0">
                <CheckBox x:Name="DebugLevelViewerCheckBox"
                          Content="Debug Tiles"
                          Checked="DebugSettingsCheckBox_OnChanged"
                          Unchecked="DebugSettingsCheckBox_OnChanged" />
                <CheckBox x:Name="DebugTileRegionsCheckBox"
                          Content="Debug Tile Regions"
                          Checked="DebugSettingsCheckBox_OnChanged"
                          Unchecked="DebugSettingsCheckBox_OnChanged" />
                <CheckBox x:Name="ShowGridCheckBox"
                          Content="Show Grid"
                          IsChecked="True"
                          Checked="DebugSettingsCheckBox_OnChanged"
                          Unchecked="DebugSettingsCheckBox_OnChanged" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ApiEndpointLabel" Text="API Endpoint" FontWeight="SemiBold" />
            <TextBox x:Name="ApiLinkTextBox" />
            <WrapPanel>
              <Button x:Name="SaveSettingsButton" Content="Save Settings" Click="SaveSettingsButton_OnClick" />
              <Button x:Name="ResetSettingsButton" Content="Reset Settings" Click="ResetSettingsButton_OnClick" />
              <Button x:Name="RefreshAllDownloadedDataButton"
                      Content="Refresh All Downloaded Course Data"
                      Click="RefreshAllDownloadedDataButton_OnClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem x:Name="CreditsTab" Header="Credits" DockPanel.Dock="Right">
        <Border Classes="panel" Margin="0,12,0,0">
          <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="760">
              <TextBlock x:Name="CreditsTitle"
                         Text="Information"
                         Classes="sectionTitle" />
              <StackPanel Spacing="6">
                <TextBlock x:Name="CreditsDescriptionText"
                           Text="This is a fanmade level downloader for Super Mario Maker 1."
                           Foreground="#2B1605"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CreditsArchiveText"
                           Text="It uses saved levels from the Wayback Machine (archive.org)."
                           Foreground="#2B1605"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CreditsDatabaseText"
                           Text="The level list is indexed in a database so courses can be searched."
                           Foreground="#2B1605"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CreditsNintendoText"
                           Text="Super Mario Maker, Mario and all related Nintendo assets belong to Nintendo."
                           Foreground="#2B1605"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock x:Name="CreditsAboutTitle"
                           Text="Credits"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#2B1605" />
                <Border Background="#FFF8D6"
                        BorderBrush="#A86725"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="48"
                            Height="48"
                            Background="#F9C74F"
                            BorderBrush="#8F4F17"
                            BorderThickness="2"
                            CornerRadius="5"
                            ClipToBounds="True">
                      <Image x:Name="HerobrineAvatarImage"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock x:Name="HerobrineRoleText"
                                 Text="Leading Developer"
                                 FontSize="11"
                                 Classes="muted" />
                      <TextBlock Text="HerobrineTVv"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="#2B1605" />
                      <WrapPanel>
                        <Button x:Name="HerobrineGithubButton"
                                Classes="socialButton"
                                ToolTip.Tip="GitHub"
                                Click="HerobrineGithubButton_OnClick">
                          <PathIcon Width="18"
                                    Height="18"
                                    Data="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.96c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.91v2.84c0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
                        </Button>
                        <Button x:Name="HerobrineDiscordButton"
                                Classes="socialButton"
                                ToolTip.Tip="Discord"
                                Click="HerobrineDiscordButton_OnClick">
                          <PathIcon Width="18"
                                    Height="18"
                                    Data="M19.54 5.4a15.1 15.1 0 0 0-3.76-1.18c-.16.29-.35.68-.48.99a14.1 14.1 0 0 0-4.18 0 9.9 9.9 0 0 0-.49-.99A15.1 15.1 0 0 0 6.87 5.4C4.49 9.01 3.84 12.53 4.16 16a15.3 15.3 0 0 0 4.61 2.38c.37-.52.7-1.07.98-1.66-.54-.21-1.06-.46-1.55-.76.13-.1.25-.2.37-.3a10.82 10.82 0 0 0 9.26 0l.38.3c-.49.3-1.01.55-1.55.76.28.59.61 1.14.98 1.66A15.3 15.3 0 0 0 22.24 16c.38-4.02-.65-7.51-2.7-10.6ZM10.1 13.86c-.9 0-1.64-.84-1.64-1.86s.72-1.86 1.64-1.86c.91 0 1.65.84 1.64 1.86 0 1.02-.73 1.86-1.64 1.86Zm6.2 0c-.9 0-1.64-.84-1.64-1.86s.72-1.86 1.64-1.86c.91 0 1.65.84 1.64 1.86 0 1.02-.73 1.86-1.64 1.86Z" />
                        </Button>
                        <Button x:Name="HerobrineTwitterButton"
                                Classes="socialButton"
                                ToolTip.Tip="X / Twitter"
                                Click="HerobrineTwitterButton_OnClick">
                          <PathIcon Width="18"
                                    Height="18"
                                    Data="M18.9 3h3.06l-6.68 7.63L23.13 21h-6.15l-4.82-6.3L6.65 21H3.59l7.14-8.16L3.2 3h6.31l4.35 5.75L18.9 3Zm-1.07 16.18h1.7L8.59 4.72H6.77l11.06 14.46Z" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Background="#FFF8D6"
                        BorderBrush="#A86725"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="48"
                            Height="48"
                            Background="#E94B35"
                            BorderBrush="#7B2018"
                            BorderThickness="2"
                            CornerRadius="5"
                            ClipToBounds="True">
                      <Image x:Name="SnoozbusterAvatarImage"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Snoozbuster"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="#2B1605" />
                      <TextBlock x:Name="SnoozbusterCreditText"
                                 Text="Course Viewer for the Course Display"
                                 Classes="muted"
                                 TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button x:Name="SnoozbusterGithubButton"
                                Classes="socialButton"
                                ToolTip.Tip="GitHub"
                                Click="SnoozbusterGithubButton_OnClick">
                          <PathIcon Width="18"
                                    Height="18"
                                    Data="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.96c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.91v2.84c0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Background="#FFF8D6"
                        BorderBrush="#A86725"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="48"
                            Height="48"
                            Background="#2D7DD2"
                            BorderBrush="#173F6E"
                            BorderThickness="2"
                            CornerRadius="5"
                            ClipToBounds="True">
                      <Image x:Name="LeoMauroAvatarImage"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="LeoMauro"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="#2B1605" />
                      <TextBlock x:Name="LeoMauroCreditText"
                                 Text="Course Viewer for the Course Display"
                                 Classes="muted"
                                 TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button x:Name="LeoMauroGithubButton"
                                Classes="socialButton"
                                ToolTip.Tip="GitHub"
                                Click="LeoMauroGithubButton_OnClick">
                          <PathIcon Width="18"
                                    Height="18"
                                    Data="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.96c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.91v2.84c0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>

              <Border Background="#FFF8D6"
                      BorderBrush="#A86725"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="SpecialThanksTitle"
                             Text="Special Thanks"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#2B1605" />
                  <TextBlock x:Name="SpecialThanksText"
                             Text="Special thanks to James M***, who brought the project back into focus and made this rework finally get started."
                             Foreground="#2B1605"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="CreditsFeedbackText"
                         Text="Leave feedback or requests for help at any time."
                         Foreground="#2B1605"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
    <Border x:Name="ProfilePage"
            Grid.Row="1"
            Classes="panel"
            Margin="16,0,16,16"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
          <Button x:Name="BackFromProfileButton"
                  Content="Back"
                  Click="BackFromProfileButton_OnClick"
                  VerticalAlignment="Top" />
          <Border Grid.Column="1"
                  Width="96"
                  Height="96"
                  Background="#E9D58A"
                  BorderBrush="#8F4F17"
                  BorderThickness="2"
                  CornerRadius="6"
                  ClipToBounds="True">
            <Image x:Name="ProfileHeaderMiiImage" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="ProfileTitle" Text="User Profile" Classes="sectionTitle" />
            <TextBlock x:Name="ProfileUserNameText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#2B1605" TextWrapping="Wrap" />
            <WrapPanel>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileTotalLevelsText" Text="Levels: 0" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileTotalStarsText" Text="Stars: 0" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileTotalDownloadsText" Text="Downloads: 0" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileTotalAttemptsText" Text="Attempts: 0" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileTotalClearsText" Text="Clears: 0" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Background="#FFF8D6" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="9,5" Margin="0,0,8,8">
                <TextBlock x:Name="ProfileAverageClearRateText" Text="Clear Rate: n/a" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
            </WrapPanel>
            <TextBlock x:Name="ProfileSummaryText"
                       Text="Loading profile..."
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ProfileLevelsLayout" Grid.Row="1" ColumnDefinitions="*,0" ColumnSpacing="12">
          <ListBox x:Name="ProfileLevelsListBox"
                   SelectionChanged="ProfileLevelsListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Margin="0,5">
                  <Border Width="72"
                          Height="42"
                          Background="#E9D58A"
                          BorderBrush="#8F4F17"
                          BorderThickness="1"
                          CornerRadius="4"
                          ClipToBounds="True"
                          Cursor="Hand"
                          PointerPressed="ProfileThumbnail_OnPointerPressed"
                          IsVisible="{Binding HasThumbnail}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#241301" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCreatorMiiImage}">
                          <Border Width="28"
                                  Height="28"
                                  Background="#E9D58A"
                                  BorderBrush="#8F4F17"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  ClipToBounds="True">
                            <Image Source="{Binding CreatorMiiImage}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Text="Creator" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWorldRecordMiiImage}">
                          <Border Width="28"
                                  Height="28"
                                  Background="#E9D58A"
                                  BorderBrush="#8F4F17"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  ClipToBounds="True">
                            <Image Source="{Binding WorldRecordMiiImage}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Text="WR" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="#" />
                              <Run Text="{Binding DisplayCode}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="✓ " />
                              <Run Text="{Binding ClearRateText}" />
                            </TextBlock>
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="▶ " />
                              <Run Text="{Binding TotalAttemptsText}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="★ " />
                              <Run Text="{Binding StarsText}" />
                            </TextBlock>
                          </Border>
                          <Border Classes="statChip">
                            <TextBlock FontSize="12" Foreground="#2B1605">
                              <Run Text="DL " />
                              <Run Text="{Binding DownloadsText}" />
                            </TextBlock>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SearchResultStatus}" FontSize="12" Foreground="#1A7A3A" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Content="{Binding DownloadButtonText}"
                          IsEnabled="{Binding CanDownload}"
                          Click="DownloadLevelButton_OnClick" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="ProfileSelectedLevelContainer" Grid.Column="1" BorderBrush="#A86725" BorderThickness="1.5" CornerRadius="5" Padding="10" Background="#FFF8D6" IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ProfileSelectedLevelTitle" Text="No level selected" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                <StackPanel x:Name="ProfileSelectedDetailsPanel" Spacing="8" IsVisible="False">
                <StackPanel Spacing="8">
                  <Grid x:Name="ProfileSelectedCreatorRow" ColumnDefinitions="64,*" ColumnSpacing="10" IsVisible="False">
                    <Border Width="46"
                            Height="46"
                            Background="#E9D58A"
                            BorderBrush="#8F4F17"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Cursor="Hand"
                            PointerPressed="ProfileSelectedCreatorMii_OnPointerPressed">
                      <Image x:Name="ProfileSelectedCreatorMiiImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="ProfileSelectedCreatorHeader" Text="Creator" FontSize="11" Classes="muted" />
                      <TextBlock x:Name="ProfileSelectedCreatorNameText" Text="-" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="ProfileSelectedWorldRecordRow" ColumnDefinitions="64,*" ColumnSpacing="10" IsVisible="False">
                    <Border Width="46"
                            Height="46"
                            Background="#E9D58A"
                            BorderBrush="#8F4F17"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Cursor="Hand"
                            PointerPressed="ProfileSelectedWorldRecordMii_OnPointerPressed">
                      <Image x:Name="ProfileSelectedWorldRecordMiiImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="ProfileSelectedWorldRecordHeader" Text="World Record" FontSize="11" Classes="muted" />
                      <TextBlock x:Name="ProfileSelectedWorldRecordText" Text="-" TextWrapping="Wrap" Foreground="#2B1605" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <TextBlock x:Name="ProfileSelectedLevelDetails" TextWrapping="Wrap" Foreground="#2B1605" />
                <WrapPanel>
                  <Border Classes="statChip">
                    <TextBlock x:Name="ProfileSelectedStarsText" Foreground="#2B1605" FontWeight="SemiBold" />
                  </Border>
                  <Border Classes="statChip">
                    <TextBlock x:Name="ProfileSelectedDownloadsText" Foreground="#2B1605" FontWeight="SemiBold" />
                  </Border>
                  <Border Classes="statChip">
                    <TextBlock x:Name="ProfileSelectedTotalRunsText" Foreground="#2B1605" FontWeight="SemiBold" />
                  </Border>
                  <Border Classes="statChip">
                    <TextBlock x:Name="ProfileSelectedClearsText" Foreground="#2B1605" FontWeight="SemiBold" />
                  </Border>
                  <Border Classes="statChip">
                    <TextBlock x:Name="ProfileSelectedClearRateText" Foreground="#2B1605" FontWeight="SemiBold" />
                  </Border>
                </WrapPanel>
                <Border x:Name="ProfileSelectedPreviewPanel"
                        Height="160"
                        BorderBrush="#A86725"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Padding="6"
                        Background="#FFF1AE"
                        Cursor="Hand"
                        PointerPressed="ProfileSelectedPreviewPanel_OnPointerPressed"
                        IsVisible="False">
                  <Viewbox Stretch="Uniform">
                    <controls:CoursePreviewControl x:Name="ProfileSelectedPreviewCanvas" />
                  </Viewbox>
                </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="CemuLevelPage"
            Grid.Row="1"
            Classes="panel"
            Margin="16,0,16,16"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
          <Button x:Name="BackFromCemuLevelButton"
                  Content="Back"
                  Click="BackFromCemuLevelButton_OnClick"
                  VerticalAlignment="Top" />
          <Border Grid.Column="1"
                  Width="160"
                  Height="92"
                  Background="#E9D58A"
                  BorderBrush="#8F4F17"
                  BorderThickness="2"
                  CornerRadius="6"
                  ClipToBounds="True">
            <Image x:Name="CemuLevelHeaderThumbnail" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="CemuPageTitle"
                       Text="CEMU Level"
                       Classes="sectionTitle"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
              <TextBlock x:Name="CemuPageCreatorHeader" Text="Creator" FontSize="11" Classes="muted" />
              <TextBlock x:Name="CemuPageClearRateHeader" Text="Clear Rate" Grid.Column="1" FontSize="11" Classes="muted" />
              <TextBlock x:Name="CemuPageWorldRecordHeader" Text="World Record" Grid.Column="2" FontSize="11" Classes="muted" />
              <DockPanel Grid.Row="1" LastChildFill="True">
                <Border x:Name="CemuCreatorMiiBorder"
                        Width="32"
                        Height="32"
                        Margin="0,0,7,0"
                        Background="#E9D58A"
                        BorderBrush="#8F4F17"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True"
                        Cursor="Hand"
                        PointerPressed="CemuCreatorMii_OnPointerPressed"
                        IsVisible="False">
                  <Image x:Name="CemuCreatorMiiImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="CemuPageCreatorText" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="CemuPageClearRateText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" />
              <DockPanel Grid.Row="1" Grid.Column="2" LastChildFill="True">
                <Border x:Name="CemuWorldRecordMiiBorder"
                        Width="32"
                        Height="32"
                        Margin="0,0,7,0"
                        Background="#E9D58A"
                        BorderBrush="#8F4F17"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True"
                        Cursor="Hand"
                        PointerPressed="CemuWorldRecordMii_OnPointerPressed"
                        IsVisible="False">
                  <Image x:Name="CemuWorldRecordMiiImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="CemuPageWorldRecordText" Text="-" FontWeight="SemiBold" Foreground="#2B1605" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Grid>
            <WrapPanel>
              <Border Classes="statChip">
                <TextBlock x:Name="CemuPageStarsText" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Classes="statChip">
                <TextBlock x:Name="CemuPageDownloadsText" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Classes="statChip">
                <TextBlock x:Name="CemuPageTotalRunsText" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Classes="statChip">
                <TextBlock x:Name="CemuPageClearsText" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
              <Border Classes="statChip">
                <TextBlock x:Name="CemuPageFolderText" Foreground="#2B1605" FontWeight="SemiBold" />
              </Border>
            </WrapPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="12">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
              <TextBlock x:Name="CemuPagePreviewInfo"
                         Text="The course preview will appear below."
                         FontSize="12"
                         Classes="muted"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button x:Name="CemuPageUnderworldButton"
                      Grid.Column="1"
                      Content="Underworld"
                      Click="CemuPageUnderworldButton_OnClick" />
              <Button x:Name="CemuPageHiddenBlocksButton"
                      Grid.Column="2"
                      Content="Reveal Hidden ? Blocks"
                      Click="CemuPageHiddenBlocksButton_OnClick" />
            </Grid>
            <ScrollViewer x:Name="CemuPagePreviewScrollViewer"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <controls:CoursePreviewControl x:Name="CemuPagePreviewCanvas" />
            </ScrollViewer>
          </Grid>
          <Border Grid.Column="1"
                  BorderBrush="#A86725"
                  BorderThickness="1.5"
                  CornerRadius="5"
                  Padding="10"
                  Background="#FFF8D6">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
              <TextBlock x:Name="CemuReplaceTitle"
                         Text="Replace with downloaded level"
                         FontWeight="SemiBold"
                         Foreground="#2B1605" />
              <TextBox x:Name="CemuReplaceSearchTextBox"
                       Grid.Row="1"
                       Watermark="Search downloaded levels"
                       TextChanged="CemuReplaceSearchTextBox_OnTextChanged" />
              <ListBox x:Name="CemuReplaceResultsListBox"
                       Grid.Row="2"
                       SelectionChanged="CemuReplaceResultsListBox_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4">
                      <Border Width="64"
                              Height="38"
                              Background="#E9D58A"
                              BorderBrush="#8F4F17"
                              BorderThickness="1"
                              CornerRadius="4"
                              ClipToBounds="True"
                              IsVisible="{Binding HasThumbnail}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="#241301"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="11"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="ReplaceCemuLevelButton"
                      Grid.Row="3"
                      Content="Replace"
                      IsEnabled="False"
                      Click="ReplaceCemuLevelButton_OnClick"
                      HorizontalAlignment="Left" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="LevelViewerPage"
            Grid.Row="1"
            Classes="panel"
            Margin="16,0,16,16"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button x:Name="BackFromViewerButton"
                  Grid.Column="0"
                  Content="Back"
                  Click="BackFromViewerButton_OnClick" />
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="LevelViewerTitle"
                       Text="Level Viewer"
                       Classes="sectionTitle"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LevelViewerInfo"
                       Text="The course preview will appear below."
                       FontSize="12"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="LevelViewerUnderworldButton"
                  Grid.Column="2"
                  Content="Underworld"
                  Click="LevelViewerUnderworldButton_OnClick" />
          <Button x:Name="LevelViewerHiddenBlocksButton"
                  Grid.Column="3"
                  Content="Reveal Hidden ? Blocks"
                  Click="LevelViewerHiddenBlocksButton_OnClick" />
        </Grid>
        <ScrollViewer x:Name="LevelViewerScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <controls:CoursePreviewControl x:Name="LevelViewerCanvas" />
        </ScrollViewer>
      </Grid>
    </Border>
    </Grid>
    <Border x:Name="NotificationToast"
            ZIndex="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,78,24,0"
            MaxWidth="430"
            Padding="12,9"
            Background="#FFF8D6"
            BorderBrush="#7B2018"
            BorderThickness="2"
            CornerRadius="5"
            BoxShadow="0 4 0 0 #6E3F17"
            IsVisible="False">
      <TextBlock x:Name="NotificationToastText"
                 Text="Ready"
                 Foreground="#2B1605"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
    </Border>
    <Border x:Name="NotificationHistoryPanel"
            ZIndex="21"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,78,24,0"
            Width="430"
            MaxHeight="420"
            Padding="12"
            Background="#FFF1AE"
            BorderBrush="#7B4A20"
            BorderThickness="2"
            CornerRadius="6"
            BoxShadow="0 4 0 0 #6E3F17"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="NotificationHistoryTitle"
                     Text="Notifications"
                     Classes="sectionTitle"
                     VerticalAlignment="Center" />
          <Button x:Name="ClearNotificationHistoryButton"
                  Grid.Column="1"
                  Content="Clear"
                  Click="ClearNotificationHistoryButton_OnClick" />
          <Button x:Name="CloseNotificationHistoryButton"
                  Grid.Column="2"
                  Content="Close"
                  Click="CloseNotificationHistoryButton_OnClick" />
        </Grid>
        <ListBox x:Name="NotificationHistoryListBox"
                 Grid.Row="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
                <TextBlock Text="{Binding DisplayText}"
                           Foreground="#2B1605"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        ToolTip.Tip="Delete"
                        Click="DeleteNotificationButton_OnClick">
                  <Path Width="13"
                        Height="15"
                        Stretch="Uniform"
                        Data="M6 2 L14 2 M8 2 L8 4 M12 2 L12 4 M4 5 L16 5 M6 5 L7 17 L13 17 L14 5 M9 8 L9 14 M11 8 L11 14"
                        Stroke="#2B1605"
                        StrokeThickness="1.7"
                        StrokeLineCap="Round" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
